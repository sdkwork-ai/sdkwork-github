{
  "$schema": "../sdkwork-github-workflow/schemas/agent-workflow.schema.json",
  "schemaVersion": "2026-06-06.agent.workflow.v1",
  "app": {
    "id": "sdkwork-github",
    "name": "SDKWork GitHub",
    "repository": "sdkwork-ai/sdkwork-github",
    "sourcePath": "apps/sdkwork-github-pc",
    "configPath": "apps/sdkwork-github-pc/agent.app.config.json"
  },
  "release": {
    "artifactPrefix": "sdkwork-github",
    "defaultVersion": "0.1.0",
    "changelog": {
      "source": "auto",
      "maxCommitSubjects": 50
    }
  },
  "toolchains": {
    "node": "22",
    "pnpm": "10.30.2",
    "rust": "stable"
  },
  "lifecycle": {
    "preflight": [],
    "install": [
      {
        "name": "Install workspace dependencies",
        "shell": "pwsh",
        "run": "pnpm install --frozen-lockfile || pnpm install"
      }
    ],
    "build": [
      {
        "name": "Verify workspace",
        "shell": "pwsh",
        "run": "pnpm check"
      }
    ],
    "package": [
      {
        "name": "Build web package",
        "shell": "pwsh",
        "run": "pnpm --dir apps/sdkwork-github-pc build"
      }
    ],
    "sign": [],
    "sbom": [],
    "validate": [
      {
        "name": "Run verification",
        "shell": "pwsh",
        "run": "pnpm verify"
      }
    ]
  },
  "targets": [
    {
      "id": "web-x64-standalone-browser-zip",
      "profileBinding": "fixed",
      "deploymentProfile": "standalone",
      "runtimeTarget": "browser",
      "targetPlatform": "web",
      "clientArchitecture": "pc-web",
      "profile": "browser",
      "platform": "web",
      "architecture": "x64",
      "formats": [
        "zip"
      ],
      "runner": "ubuntu-24.04",
      "outputGlobs": [
        "apps/sdkwork-github-pc/dist/**"
      ]
    }
  ],
  "dependencies": [
    {
      "id": "sdkwork-app-topology",
      "repository": "sdkwork-ai/sdkwork-app-topology",
      "refInput": "SDKWORK_APP_TOPOLOGY_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-appbase",
      "repository": "sdkwork-ai/sdkwork-appbase",
      "refInput": "SDKWORK_APPBASE_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-core",
      "repository": "sdkwork-ai/sdkwork-core",
      "refInput": "SDKWORK_CORE_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-database",
      "repository": "sdkwork-ai/sdkwork-database",
      "refInput": "SDKWORK_DATABASE_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-iam",
      "repository": "sdkwork-ai/sdkwork-iam",
      "refInput": "SDKWORK_IAM_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-id",
      "repository": "sdkwork-ai/sdkwork-id",
      "refInput": "SDKWORK_ID_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-sdk-commons",
      "repository": "sdkwork-ai/sdkwork-sdk-commons",
      "refInput": "SDKWORK_SDK_COMMONS_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-ui",
      "repository": "sdkwork-ai/sdkwork-ui",
      "refInput": "SDKWORK_UI_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-utils",
      "repository": "sdkwork-ai/sdkwork-utils",
      "refInput": "SDKWORK_UTILS_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-web-framework",
      "repository": "sdkwork-ai/sdkwork-web-framework",
      "refInput": "SDKWORK_WEB_FRAMEWORK_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    }
  ]
}
