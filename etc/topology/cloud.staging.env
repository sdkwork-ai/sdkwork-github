# Bootstrap profile cloud.staging — replace with application-specific values.
SDKWORK_GITHUB_DEPLOYMENT_PROFILE=cloud
SDKWORK_GITHUB_ENVIRONMENT=staging
SDKWORK_GITHUB_PROFILE_ID=cloud.staging
SDKWORK_GITHUB_APPLICATION_PUBLIC_HTTP_URL=https://github-staging.sdkwork.com
SDKWORK_GITHUB_PLATFORM_API_GATEWAY_HTTP_URL=https://api-staging.sdkwork.com


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_GITHUB_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

SDKWORK_CORS_ALLOWED_ORIGINS=https://github-staging.sdkwork.com,http://github-staging.sdkwork.com,https://github-staging.birdcoder.com,http://github-staging.birdcoder.com,https://github-staging.dtupay.com,http://github-staging.dtupay.com,https://github-staging.noaper.com,http://github-staging.noaper.com,https://github-staging.sdkwork.cn,http://github-staging.sdkwork.cn,https://github-staging.birdcoder.cn,http://github-staging.birdcoder.cn,https://github-staging.dtupay.cn,http://github-staging.dtupay.cn,https://github-staging.noaper.cn,http://github-staging.noaper.cn,https://github-staging.skubc.com,http://github-staging.skubc.com,https://github-staging.skubc.cn,http://github-staging.skubc.cn,https://github-staging.zowalk.com,http://github-staging.zowalk.com,https://github-staging.zowalk.cn,http://github-staging.zowalk.cn,https://github-staging.offer86.com,http://github-staging.offer86.com,https://github-staging.offer86.cn,http://github-staging.offer86.cn,https://github-staging.86offer.com,http://github-staging.86offer.com,https://github-staging.86offer.cn,http://github-staging.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
