# Bootstrap profile standalone.test — replace with application-specific values.
SDKWORK_GITHUB_DEPLOYMENT_PROFILE=standalone
SDKWORK_GITHUB_ENVIRONMENT=test
SDKWORK_GITHUB_PROFILE_ID=standalone.test
SDKWORK_GITHUB_APPLICATION_PUBLIC_HTTP_URL=https://github-test.sdkwork.com
SDKWORK_GITHUB_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:4100
VITE_SDKWORK_GITHUB_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:4100


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_GITHUB_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
