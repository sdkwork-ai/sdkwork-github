# Isolated demo environment (standalone.demo).
# Independent database schema: sdkwork_github_demo
# Independent Redis prefix: github-demo (logical DB index 9) to avoid sharing conflicts on a shared Redis.
SDKWORK_GITHUB_DEPLOYMENT_PROFILE=standalone
SDKWORK_GITHUB_ENVIRONMENT=demo
SDKWORK_GITHUB_PROFILE_ID=standalone.demo
SDKWORK_GITHUB_APPLICATION_PUBLIC_HTTP_URL=https://github-demo.sdkwork.com
