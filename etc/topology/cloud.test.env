# Bootstrap profile cloud.test — replace with application-specific values.
SDKWORK_GITHUB_DEPLOYMENT_PROFILE=cloud
SDKWORK_GITHUB_ENVIRONMENT=test
SDKWORK_GITHUB_PROFILE_ID=cloud.test
SDKWORK_GITHUB_APPLICATION_PUBLIC_HTTP_URL=https://github-test.sdkwork.com
SDKWORK_GITHUB_PLATFORM_API_GATEWAY_HTTP_URL=https://api-test.sdkwork.com


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_GITHUB_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

