# Isolated demo environment (cloud.demo).
# Independent database schema: sdkwork_github_demo
# Independent Redis prefix: github-demo (logical DB index 9) to avoid sharing conflicts on a shared Redis.
SDKWORK_GITHUB_DEPLOYMENT_PROFILE=cloud
SDKWORK_GITHUB_ENVIRONMENT=demo
SDKWORK_GITHUB_PROFILE_ID=cloud.demo
SDKWORK_GITHUB_APPLICATION_PUBLIC_HTTP_URL=https://github-demo.sdkwork.com
SDKWORK_GITHUB_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_GITHUB_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
SDKWORK_CORS_ALLOWED_ORIGINS=https://github-demo.sdkwork.com,http://github-demo.sdkwork.com,https://github-demo.birdcoder.com,http://github-demo.birdcoder.com,https://github-demo.dtupay.com,http://github-demo.dtupay.com,https://github-demo.noaper.com,http://github-demo.noaper.com,https://github-demo.sdkwork.cn,http://github-demo.sdkwork.cn,https://github-demo.birdcoder.cn,http://github-demo.birdcoder.cn,https://github-demo.dtupay.cn,http://github-demo.dtupay.cn,https://github-demo.noaper.cn,http://github-demo.noaper.cn,https://github-demo.skubc.com,http://github-demo.skubc.com,https://github-demo.skubc.cn,http://github-demo.skubc.cn,https://github-demo.zowalk.com,http://github-demo.zowalk.com,https://github-demo.zowalk.cn,http://github-demo.zowalk.cn,https://github-demo.offer86.com,http://github-demo.offer86.com,https://github-demo.offer86.cn,http://github-demo.offer86.cn,https://github-demo.86offer.com,http://github-demo.86offer.com,https://github-demo.86offer.cn,http://github-demo.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
